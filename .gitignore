# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Bundler
/.bundle
/vendor/bundle

# Database
/db/*.sqlite3
/db/*.sqlite3-*

# Logs and temp
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep

# Storage
/storage/*
!/storage/.keep
/public/uploads

# Assets
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Node
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Environment
.env*
!.env.example

# System
.DS_Store
.byebug_history

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Test
/coverage

# Rails
/public/packs
/public/packs-test
.pry_history

# Master key
/config/master.key
/config/credentials/*.key

# Temporary files
*.tmp
*.bak
*.backup

# Lock files - generated in Docker during build
Gemfile.lock
yarn.lock
package-lock.json