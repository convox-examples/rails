# Copy this file to .env for local development
# In production, set these via Convox environment variables

# Rails settings
RAILS_ENV=development
SECRET_KEY_BASE=your-secret-key-base-here

# Database (for local development)
# In production, Convox provides DATABASE_URL automatically
DATABASE_URL=postgres://rails:rails@localhost:5432/rails_app_development

# Redis (for local development)  
# In production, Convox provides CACHE_URL automatically
CACHE_URL=redis://localhost:6379/0

# Rails settings
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# Optional: Allow all hosts (useful for development)
# ALLOW_ALL_HOSTS=true