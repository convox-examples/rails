<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= @user.name %> - Convox Rails</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            line-height: 1.6;
            color: #2D3133;
            background: linear-gradient(135deg, #11BADF 0%, #11495A 100%);
            min-height: 100vh;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem;
        }
        header {
            text-align: center;
            color: #FFFFFF;
            padding: 2rem 0;
        }
        h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            text-shadow: 2px 2px 4px rgba(2, 38, 48, 0.3);
        }
        .main-content {
            background: #FFFFFF;
            border-radius: 12px;
            padding: 2rem;
            box-shadow: 0 10px 40px rgba(2, 38, 48, 0.2);
        }
        .button {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: #11BADF;
            color: #FFFFFF;
            text-decoration: none;
            border-radius: 6px;
            transition: all 0.2s;
            font-weight: 500;
            border: none;
            cursor: pointer;
        }
        .button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(17, 186, 223, 0.3);
            background: #23DEFF;
        }
        .button-secondary {
            background: #11495A;
        }
        .button-danger {
            background: #ff4444;
        }
        .notice {
            background: #00C851;
            color: white;
            padding: 1rem;
            border-radius: 6px;
            margin-bottom: 1rem;
        }
        .user-details {
            margin-top: 2rem;
        }
        .detail-row {
            display: flex;
            padding: 1rem;
            border-bottom: 1px solid #EDEDED;
        }
        .detail-label {
            font-weight: 600;
            color: #11495A;
            width: 150px;
        }
        .detail-value {
            color: #2D3133;
            flex: 1;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>User Details</h1>
            <p style="color: #9AEDFF;">View user information</p>
        </header>

        <div class="main-content">
            <% if notice.present? %>
                <div class="notice"><%= notice %></div>
            <% end %>

            <h2 style="color: #11495A; margin-bottom: 1rem;"><%= @user.name %></h2>
            
            <div class="user-details">
                <div class="detail-row">
                    <div class="detail-label">ID:</div>
                    <div class="detail-value"><%= @user.id %></div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">Name:</div>
                    <div class="detail-value"><%= @user.name %></div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">Email:</div>
                    <div class="detail-value"><%= @user.email %></div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">Bio:</div>
                    <div class="detail-value"><%= @user.bio.presence || "No bio provided" %></div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">Created:</div>
                    <div class="detail-value"><%= @user.created_at.strftime("%B %d, %Y at %I:%M %p") %></div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">Last Updated:</div>
                    <div class="detail-value"><%= @user.updated_at.strftime("%B %d, %Y at %I:%M %p") %></div>
                </div>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <%= link_to "Edit", edit_user_path(@user), class: "button" %>
                <%= link_to "Back to Users", users_path, class: "button button-secondary" %>
                <%= button_to "Delete", @user, method: :delete, 
                    data: { confirm: "Are you sure you want to delete this user?" }, 
                    class: "button button-danger" %>
            </div>
        </div>
    </div>
</body>
</html>